# Required
DJANGO_BASE_URL=http://localhost:8000/api/v1
DJANGO_PUBLIC_HOST=localhost:8000
REDIS_URL=redis://localhost:6379/0
INTERNAL_EVENTS_SECRET=change-me
# Platform media origin for product-image URLs; no default — startup fails
# without it (a guessed host produced image URLs that resolve nowhere).
ASSETS_HOST=assets.localhost

# Optional (defaults shown unless noted)
LISTEN_ADDR=:8080
# One of production | staging | development | test. Anything else refuses
# to boot. Only production advertises the payment handler as production;
# development and test additionally relax UCP webhook validation to local
# http(s) endpoints. The default is production.
ENV=development
# Any slog level; the default is info.
LOG_LEVEL=debug
TENANT_CACHE_TTL=5m
TENANT_NEGATIVE_CACHE_TTL=1m
UPSTREAM_TIMEOUT=10s
RATE_LIMIT_PER_MIN=120
RATE_LIMIT_BURST=40

# Image URL templates. Placeholders: {assets_host}, {schema}, {path}.
MEDIA_IMAGE_URL_TEMPLATE=https://{assets_host}/media_stream-image/{path}/800/800/contain/entropy/transparent/5/80.webp
# Meta/TikTok require >=500x500 JPEG/PNG (never WebP), hence its own template.
FEED_IMAGE_URL_TEMPLATE=https://{assets_host}/media_stream-image/{path}/1000/1000/contain/center/FFFFFF/5/85.jpeg
FEED_FRESH_TTL=6h
FEED_STALE_TTL=24h

# Chat (first-party shopping assistant) — OpenAI-compatible protocol.
# The chat API key is PER-TENANT (Tenant.chatApiKey from tenant/resolve),
# not an env var — an empty tenant key disables /chat for that tenant.
# These env vars only set the shared provider endpoint + default model;
# defaults target the Gemini free tier (best Greek of the zero-cost
# options), and any OpenAI-compatible provider is a config swap.
CHAT_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
CHAT_MODEL=gemini-3.5-flash-lite
CHAT_EFFORT=low
CHAT_MAX_TOKENS=2048
CHAT_MAX_TURNS=40
CHAT_MAX_ITERATIONS=6
CHAT_RATE_LIMIT_PER_MIN=20
CHAT_RATE_LIMIT_BURST=5
CHAT_MAX_MESSAGE_LEN=2000
CHAT_CONVERSATION_TTL=24h
