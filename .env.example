# Required
# An absolute http(s) URL with a host, and no user info, query or fragment.
DJANGO_BASE_URL=http://localhost:8000/api/v1
DJANGO_PUBLIC_HOST=localhost:8000
REDIS_URL=redis://localhost:6379/0
# Sent and checked as a header value: no control characters (mind a
# trailing newline), no leading or trailing blanks. production and staging
# refuse one shorter than 32 characters; generate it with
# openssl rand -hex 32. This placeholder boots only under development or test.
INTERNAL_EVENTS_SECRET=change-me
# Seals each store's UCP order-webhook signing key in Redis (AES-256-GCM),
# which other services share. 32 random bytes in standard base64: generate
# one with openssl rand -base64 32. Required in every ENV, and never
# changed in place: a key sealed under another one does not open, and the
# store's profile then answers 503.
SIGNING_KEY_ENCRYPTION_KEY=
# Platform media origin for product-image URLs; no default — startup fails
# without it (a guessed host produced image URLs that resolve nowhere).
ASSETS_HOST=assets.localhost
# Django's staff OAuth issuer, named by /mcp/admin's protected-resource metadata.
STAFF_CONNECT_HOST=connect.localhost
# The language the storefront's unprefixed pages render: its build-time
# DEFAULT_LOCALE (i18n/locales.ts). Links into the storefront prefix any
# other language with /<code>. No default — startup fails without it.
STOREFRONT_DEFAULT_LOCALE=el

# Optional (defaults shown unless noted)
LISTEN_ADDR=:8080
# One of production | staging | development | test. Anything else refuses
# to boot. Only production advertises the payment handler as production;
# development and test additionally relax UCP webhook validation to local
# http(s) endpoints. The default is production.
ENV=development
# Any slog level; the default is info.
LOG_LEVEL=debug
TENANT_CACHE_TTL=5m
TENANT_NEGATIVE_CACHE_TTL=1m
# The longest one call waits for Django. It also sizes the checkout
# guards: a completion's budget is 3 of it, a session lock 9 and an
# idempotency claim 10.
UPSTREAM_TIMEOUT=10s
# A completion whose order Django left unanswered (a lost connection, a
# 5xx, a timeout) sends it again, up to ORDER_CREATE_ATTEMPTS times in
# all, ORDER_CREATE_RETRY_DELAY apart: Django answers a repeat with the
# order the checkout placed. All attempts share one UPSTREAM_TIMEOUT, so
# the waits between them must take less than it; at most 5 attempts, half
# of Django's 10 order creations a minute per cart.
ORDER_CREATE_ATTEMPTS=3
ORDER_CREATE_RETRY_DELAY=2s
# A platform's RFC 9421 request signature that carries `created` verifies
# for UCP_SIGNATURE_MAX_AGE after it; a `created` in the future, or an
# `expires` in the past, is allowed by up to UCP_SIGNATURE_CLOCK_SKEW.
UCP_SIGNATURE_MAX_AGE=5m
UCP_SIGNATURE_CLOCK_SKEW=1m
RATE_LIMIT_PER_MIN=120
RATE_LIMIT_BURST=40

# Image URL templates. Placeholders: {assets_host} and {path} (both
# required) and {schema}; any other {...} refuses to boot. Each must expand
# to an absolute http(s) URL.
MEDIA_IMAGE_URL_TEMPLATE=https://{assets_host}/media_stream-image/{path}/800/800/contain/entropy/transparent/5/80.webp
# Meta/TikTok require >=500x500 JPEG/PNG (never WebP), hence its own template.
FEED_IMAGE_URL_TEMPLATE=https://{assets_host}/media_stream-image/{path}/1000/1000/contain/center/FFFFFF/5/85.jpeg
FEED_FRESH_TTL=6h
# Must not be shorter than FEED_FRESH_TTL.
FEED_STALE_TTL=24h

# Chat (first-party shopping assistant) — OpenAI-compatible protocol.
# The chat API key is PER-TENANT (Tenant.chatApiKey from tenant/resolve),
# not an env var — an empty tenant key disables /chat for that tenant.
# These env vars only set the shared provider endpoint + default model;
# defaults target the Gemini free tier (best Greek of the zero-cost
# options), and any OpenAI-compatible provider is a config swap.
# Same rule as DJANGO_BASE_URL.
CHAT_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
CHAT_MODEL=gemini-3.5-flash-lite
# reasoning_effort: none | minimal | low | medium | high | xhigh | max.
CHAT_EFFORT=low
CHAT_MAX_TOKENS=2048
# Stored messages a conversation may hold, the shopper's and the
# assistant's: two per exchange, so 40 is 20 exchanges.
CHAT_MAX_TURNS=40
CHAT_MAX_ITERATIONS=6
# Bounds a turn's model calls and when a tool call may start, counted
# from the turn's start: past it, the turn ends with the retryable error
# instead of hanging. A tool call already running is never cut midway;
# a turn can still fail after a cart change (reporting that is #94).
# Keep it under Cloudflare's Proxy Read Timeout, which ends a response
# that sends nothing for that long.
CHAT_TURN_TIMEOUT=60s
CHAT_RATE_LIMIT_PER_MIN=20
CHAT_RATE_LIMIT_BURST=5
CHAT_STORE_TURNS_PER_HOUR=200
CHAT_VISITOR_TURNS_PER_DAY=30
CHAT_MAX_MESSAGE_LEN=2000
CHAT_CONVERSATION_TTL=24h
