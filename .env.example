# Required
DJANGO_BASE_URL=http://localhost:8000/api/v1
DJANGO_PUBLIC_HOST=localhost:8000
REDIS_URL=redis://localhost:6379/0
INTERNAL_EVENTS_SECRET=change-me

# Optional (defaults shown)
LISTEN_ADDR=:8080
ENV=dev
LOG_LEVEL=debug
TENANT_CACHE_TTL=5m
TENANT_NEGATIVE_CACHE_TTL=1m
UPSTREAM_TIMEOUT=10s
RATE_LIMIT_PER_MIN=120
RATE_LIMIT_BURST=40
