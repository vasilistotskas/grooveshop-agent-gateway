# Required
DJANGO_BASE_URL=http://localhost:8000/api/v1
DJANGO_PUBLIC_HOST=localhost:8000
REDIS_URL=redis://localhost:6379/0
INTERNAL_EVENTS_SECRET=change-me
# Platform media origin for product-image URLs; no default — startup fails
# without it (a guessed host produced image URLs that resolve nowhere).
ASSETS_HOST=assets.localhost

# Optional (defaults shown)
LISTEN_ADDR=:8080
ENV=dev
LOG_LEVEL=debug
TENANT_CACHE_TTL=5m
TENANT_NEGATIVE_CACHE_TTL=1m
UPSTREAM_TIMEOUT=10s
RATE_LIMIT_PER_MIN=120
RATE_LIMIT_BURST=40

# Chat (first-party shopping assistant) — OpenAI-compatible protocol.
# The chat API key is PER-TENANT (Tenant.chatApiKey from tenant/resolve),
# not an env var — an empty tenant key disables /chat for that tenant.
# These env vars only set the shared provider endpoint + default model;
# defaults target the Gemini free tier (best Greek of the zero-cost
# options), and any OpenAI-compatible provider is a config swap.
CHAT_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
CHAT_MODEL=gemini-3.5-flash-lite
CHAT_EFFORT=low
